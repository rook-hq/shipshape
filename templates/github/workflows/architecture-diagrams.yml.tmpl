# What this is: an optional check that the generated Mermaid diagrams parse.
# It runs only when diagrams.ci_validate is true. It renders SVG with
# beautiful-mermaid and does not regenerate docs/architecture/presentation.
# Safe to edit: yes — shipshape will ask before overwriting your edits.
# managed-by: shipshape v{{KIT_VERSION}}
name: Architecture diagrams

on:
  push:
    branches: ["{{DEFAULT_BRANCH}}"]
  pull_request:

permissions:
  contents: read

jobs:
  render:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-node@v7
        with:
          node-version: "{{NODE_VERSION}}"
      - name: Render Mermaid diagrams to SVG
        run: |
          set -eu
          test -f docs/architecture/overview.md
          work="${RUNNER_TEMP}/architecture-diagrams"
          mkdir -p "${work}"
          npm install --prefix "${work}" --ignore-scripts beautiful-mermaid@1.1.3
          cat > "${work}/render-diagrams.mjs" <<'EOF'
          import { readFileSync } from "node:fs";
          import { renderMermaidSVG } from "beautiful-mermaid";

          const text = readFileSync(process.argv[2], "utf8");
          const blocks = [...text.matchAll(/```mermaid\r?\n([\s\S]*?)```/g)].map(
            (match) => match[1],
          );
          if (blocks.length === 0) {
            console.error("no mermaid blocks in docs/architecture/overview.md");
            process.exit(1);
          }
          blocks.forEach((block, index) => {
            const svg = renderMermaidSVG(block);
            if (!svg.includes("<svg")) {
              console.error(`block ${index} did not render`);
              process.exit(1);
            }
          });
          EOF
          node "${work}/render-diagrams.mjs" docs/architecture/overview.md
